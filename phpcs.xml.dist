<?xml version="1.0"?>
<ruleset name="Lodestar Directory">
	<description>Coding standards for Lodestar Directory.</description>

	<!-- What to scan. -->
	<file>lodestar-directory.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>tests</file>

	<!-- Exclusions. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<!-- Run against the PHP version we support. -->
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.4"/>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- WordPress-Extra plus docs, per the SDD. -->
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Text domain enforcement. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="lodestar"/>
			</property>
		</properties>
	</rule>

	<!-- Prefix enforcement for globals. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="lodestar"/>
				<element value="Lodestar"/>
			</property>
		</properties>
	</rule>
</ruleset>
